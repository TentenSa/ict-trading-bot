# --- Credentials: never commit, in case one is ever placed here ---
# (real creds live in ~/.claude/broker_creds.json, outside this repo)
*creds*.json
*.key
*.secret

# --- Caches / generated ---
# Upstox instrument master (~43MB, re-downloaded every 24h)
.cache/
__pycache__/
*.pyc

# --- Run logs (cron + watch/scan output) ---
resolve_log.txt
watch_*.log
scan_*.log

# --- Editor / office lock files ---
.~lock.*#

# Build artifact: regenerated by make_journal.py from journal_annotations.json
*.xlsx

# --- Transient runtime state (watcher PIDs) ---
*.pid
